{
  "name": "shiro",
  "version": "0.1.0",
  "private": true,
  "description": "Local ChatGPT Sol coding-agent bridge powered by DeepSeek Harness",
  "scripts": {
    "test": "node --test bridge/tests/*.test.js",
    "shiro": "node bridge/bin/shiro.mjs",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Desktop.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Shiro.ps1",
    "start:linux": "bash scripts/Start-Shiro.sh",
    "stop:linux": "bash scripts/Stop-Shiro.sh",
    "tunnel:install": "bash scripts/Install-Shiro-Tunnel-Client.sh",
    "tunnel:linux": "bash scripts/Start-Shiro-Tunnel.sh",
    "install:omarchy": "bash scripts/Install-Shiro-Omarchy.sh",
    "prompt:repeat": "node scripts/Repeat-ChatGPT-Prompt.mjs",
    "fleet:temporary": "node scripts/Run-Hachimi-Temporary-Fleet.mjs"
  }
}

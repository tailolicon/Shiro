# Dependencies and generated engine output
**/node_modules/
.pnpm-store/
engine/.shiro-build-ready
engine/.cache/
engine/**/dist/
engine/**/*.tsbuildinfo

# Desktop build artifacts
desktop/dist/
desktop/.pake/
desktop/src-tauri/target/
desktop/*.exe
desktop/*.msi
# One-click launcher binary (rebuild with scripts/Build-Launcher.ps1)
/Shiro.exe

# Local state and secrets must never enter Git
.env
.env.*
!.env.example
.shiro-runtime/
*.log

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# linux migration backup excludes
node_modules/
.shiro-smoke/

# Scratch produced by agent turns, and sibling projects that are their own
# repositories -- committing either into Shiro would swallow work that does not
# belong to it.
/.tmp/
/.tmp-*/
/.dual-lane-patch-*/
/ai-game-factory/
/hachimi-tl-vi/
/hachimi-throughput-fix/
/hachimi-dual-lane-live/
/aiko-validation/
/aiko-validation2/
/live-b*.json
/current-screen*.png
/tmp/

# The runtime copy the profile used to pin: generated, and pinning it froze the
# bridge at whatever was copied. The profile now loads bridge/src directly.
bridge/.runtime-live/
